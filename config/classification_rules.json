{
  "schema_version": 1,
  "ruleset_version": "1.3.0",
  "rules": [
    {
      "id": "tag_create_tokens_oracle_text",
      "enabled": true,
      "target_type": "tag",
      "target_id": "create_tokens",
      "source_fields": [
        "oracle_mechanics"
      ],
      "match": {
        "type": "oracle_mechanic_any",
        "values": [
          "token.create"
        ]
      },
      "weight": 0.8,
      "confidence": 0.75,
      "evidence_label": "Oracle text indicates token creation.",
      "requires_review": false
    },
    {
      "id": "tag_artifact_type_line",
      "enabled": true,
      "target_type": "tag",
      "target_id": "artifact_count",
      "source_fields": [
        "type_line_normalized"
      ],
      "match": {
        "type": "type_line_contains",
        "values": [
          "artifact"
        ]
      },
      "weight": 0.3,
      "confidence": 0.4,
      "evidence_label": "The type line contains Artifact; this alone does not establish functional synergy.",
      "requires_review": true
    },
    {
      "id": "role_land_type_line",
      "enabled": true,
      "target_type": "role",
      "target_id": "land",
      "source_fields": [
        "type_line_normalized"
      ],
      "match": {
        "type": "type_line_contains",
        "values": [
          "land"
        ]
      },
      "weight": 0.9,
      "confidence": 0.95,
      "evidence_label": "The type line identifies a land.",
      "requires_review": false
    },
    {
      "id": "role_card_draw_oracle_text",
      "enabled": true,
      "target_type": "role",
      "target_id": "card_draw",
      "source_fields": [
        "oracle_mechanics"
      ],
      "match": {
        "type": "oracle_mechanic_any",
        "values": [
          "card.draw"
        ]
      },
      "weight": 0.7,
      "confidence": 0.65,
      "evidence_label": "Oracle text suggests card draw.",
      "requires_review": true
    },
    {
      "id": "strategy_lifegain_oracle_text",
      "enabled": true,
      "target_type": "strategy",
      "target_id": "lifegain",
      "source_fields": [
        "oracle_mechanics"
      ],
      "match": {
        "type": "oracle_mechanic_any",
        "values": [
          "life.gain",
          "life.gain_trigger"
        ],
        "where": {"subject": "you"}
      },
      "weight": 0.5,
      "confidence": 0.55,
      "evidence_label": "Oracle text mentions life gain; strategic intent requires context.",
      "requires_review": true
    },
    {
      "id": "tag_noncombat_damage_opponents",
      "enabled": true,
      "target_type": "tag",
      "target_id": "noncombat_damage",
      "source_fields": [
        "oracle_mechanics"
      ],
      "match": {
        "type": "oracle_mechanic_any",
        "values": [
          "damage.noncombat_opponents"
        ]
      },
      "weight": 0.6,
      "confidence": 0.6,
      "evidence_label": "Oracle text mentions direct damage to opponents without relying on combat.",
      "requires_review": true
    },
    {
      "id": "tag_combat_damage_oracle_text",
      "enabled": true,
      "target_type": "tag",
      "target_id": "combat_damage",
      "source_fields": [
        "oracle_mechanics"
      ],
      "match": {
        "type": "oracle_mechanic_any",
        "values": [
          "damage.combat"
        ]
      },
      "weight": 0.5,
      "confidence": 0.6,
      "evidence_label": "Oracle text ties the effect to combat damage, not burn.",
      "requires_review": true
    },
    {
      "id": "tag_land_ramp_oracle_text",
      "enabled": true,
      "target_type": "tag",
      "target_id": "land_ramp",
      "source_fields": [
        "oracle_mechanics"
      ],
      "match": {
        "type": "oracle_mechanic_any",
        "values": [
          "land.search_to_battlefield"
        ]
      },
      "weight": 0.7,
      "confidence": 0.7,
      "evidence_label": "Oracle text suggests searching for a land as ramp.",
      "requires_review": true
    },
    {
      "id": "tag_reanimate_creature_oracle_text",
      "enabled": true,
      "target_type": "tag",
      "target_id": "reanimate_creature",
      "source_fields": [
        "oracle_mechanics"
      ],
      "match": {
        "type": "oracle_mechanic_any",
        "values": [
          "creature.return_from_graveyard"
        ]
      },
      "weight": 0.8,
      "confidence": 0.75,
      "evidence_label": "Oracle text returns a creature from a graveyard to the battlefield.",
      "requires_review": false
    },
    {
      "id": "tag_single_creature_buff_oracle_text",
      "enabled": true,
      "target_type": "tag",
      "target_id": "single_creature_buff",
      "source_fields": [
        "oracle_mechanics"
      ],
      "match": {
        "type": "oracle_mechanic_any",
        "values": [
          "creature.plus_one_plus_one_modifier"
        ]
      },
      "weight": 0.35,
      "confidence": 0.45,
      "evidence_label": "Oracle text suggests a concentrated buff; this alone does not establish a Voltron strategy.",
      "requires_review": true
    }
  ]
}
